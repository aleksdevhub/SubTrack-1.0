@model SubTrack.Models.Subscription

@{
    ViewData["Title"] = "Добавление подписки";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div style="max-width: 480px; margin: 40px auto; background: #1e1e24; border: 1px solid #3b3b42; border-radius: 12px; padding: 28px;">

    <h2 style="font-size: 18px; font-weight: 600; color: #ffffff; margin-bottom: 6px;">Добавить подписку</h2>
    <p style="font-size: 12px; color: #85858b; margin-bottom: 24px;">Заполните информацию о сервисе, чтобы отслеживать списания.</p>

    <form asp-controller="Home" asp-action="AddSubscription" method="post" style="display: flex; flex-direction: column; gap: 16px;">

        <!-- Название сервиса -->
        <div style="display: flex; flex-direction: column; gap: 6px;">
            <label asp-for="Name" style="font-size: 11px; font-weight: 500; color: #85858b;">Название сервиса</label>
            <input asp-for="Name" type="text" placeholder="Например: Netflix, Spotify..." required
                   style="height: 38px; background: #121214; border: 1px solid #3b3b42; border-radius: 6px; padding: 0 12px; color: #ffffff; font-family: inherit; font-size: 13px; outline: none;" />
        </div>

        <div style="display: grid; grid-template-columns: 1fr 80px; gap: 12px;">
            <!-- Стоимость -->
            <div style="display: flex; flex-direction: column; gap: 6px;">
                <label asp-for="Price" style="font-size: 11px; font-weight: 500; color: #85858b;">Стоимость</label>
                <input asp-for="Price" type="number" step="0.01" placeholder="0.00" required
                       style="height: 38px; background: #121214; border: 1px solid #3b3b42; border-radius: 6px; padding: 0 12px; color: #ffffff; font-family: inherit; font-size: 13px; outline: none;" />
            </div>

            <!-- Валюта -->
            <div style="display: flex; flex-direction: column; gap: 6px;">
                <label asp-for="Currency" style="font-size: 11px; font-weight: 500; color: #85858b;">Валюта</label>
                <select asp-for="Currency" style="height: 38px; background: #121214; border: 1px solid #3b3b42; border-radius: 6px; padding: 0 8px; color: #ffffff; font-family: inherit; font-size: 13px; outline: none; cursor: pointer;">
                    <option value="₽">₽</option>
                    <option value="$">$</option>
                    <option value="€">€</option>
                </select>
            </div>
        </div>

        <!-- Выбор категории -->
        <div style="display: flex; flex-direction: column; gap: 6px;">
            <label asp-for="CategoryId" style="font-size: 11px; font-weight: 500; color: #85858b;">Категория расходов</label>
            <select asp-for="CategoryId" required style="height: 38px; background: #121214; border: 1px solid #3b3b42; border-radius: 6px; padding: 0 8px; color: #ffffff; font-family: inherit; font-size: 13px; outline: none; cursor: pointer;">
                <option value="" disabled selected>Выберите категорию...</option>
                @if (ViewBag.Categories != null)
                {
                    foreach (var cat in (List<SubTrack.Models.Category>)ViewBag.Categories)
                    {
                        <option value="@cat.Id">@cat.Name</option>
                    }
                }
            </select>
        </div>

        <!-- Кнопки управления -->
        <div style="display: flex; gap: 12px; margin-top: 12px;">
            <a asp-controller="Home" asp-action="Index"
               style="flex: 1; height: 38px; background: #26262d; border: 1px solid #3b3b42; border-radius: 6px; color: #d7d7dc; font-size: 12px; font-weight: 600; text-decoration: none; display: flex; align-items: center; justify-content: center; transition: background 0.2s;">
                Отмена
            </a>
            <button type="submit"
                    style="flex: 1; height: 38px; background: #6366f1; border: none; border-radius: 6px; color: #ffffff; font-size: 12px; font-weight: 600; cursor: pointer; transition: background 0.2s;">
                Добавить
            </button>
        </div>

    </form>
</div>
